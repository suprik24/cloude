{
  "name": "cloude",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "prepare": "npm run hooks:install",
    "hooks:install": "node -e \"const fs=require('fs');if(fs.existsSync('.git')){fs.copyFileSync('.githooks/pre-commit','.git/hooks/pre-commit');fs.chmodSync('.git/hooks/pre-commit',0o755)}\"",
    "generate-types": "wrangler types"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "svelte": "^5.57.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/svelte": "^9.1.2",
    "astro": "^7.4.8",
    "better-auth": "^1.7.18",
    "wrangler": "^4.159.0"
  }
}
