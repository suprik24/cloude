{
  "name": "cloude",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "i18n:compile": "paraglide-js compile --project ./project.inlang",
    "build": "npm run i18n:compile && astro build",
    "preview": "astro preview",
    "check": "npm run i18n:compile && astro check",
    "prepare": "npm run hooks:install",
    "hooks:install": "node -e \"const fs=require('fs');if(fs.existsSync('.git')){fs.copyFileSync('.githooks/pre-commit','.git/hooks/pre-commit');fs.chmodSync('.git/hooks/pre-commit',0o755)}\"",
    "generate-types": "wrangler types",
    "auth:schema": "node scripts/generate-auth-schema.ts",
    "db:migrate:local": "wrangler d1 migrations apply cloude-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cloude-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@inlang/paraglide-js": "^3.2.2",
    "@types/node": "^26.6.6",
    "svelte": "^5.59.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/svelte": "^9.1.6",
    "astro": "^7.4.13",
    "better-auth": "^1.7.27",
    "wrangler": "^4.167.0"
  }
}
