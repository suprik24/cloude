{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-03",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"name": "cloude",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cloude-db",
			"database_id": "0aed3156-5f22-4d8e-b6df-883ece02a344"
		}
	]
}